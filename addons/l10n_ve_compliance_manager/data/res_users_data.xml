<odoo>
    <data noupdate="1">
        <!-- Bot user for Asistente Fiscal -->
        <record id="user_contafis_bot" model="res.users">
            <field name="name">ContaFis AI</field>
            <field name="login">contafis_bot</field>
            <field name="email">bot@contafis.local</field>
            <field name="password">bot_unusable_password_123</field>
            <field name="active" eval="True"/>
            <field name="share" eval="False"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="group_ids" eval="[(6, 0, [
                ref('base.group_user')
            ])]"/>
        </record>

        <!-- Partner for the bot -->
        <record id="partner_contafis_bot" model="res.partner">
            <field name="name">ContaFis AI</field>
            <field name="email">bot@contafis.local</field>
            <field name="is_company" eval="False"/>
            <field name="type" eval="False"/>
        </record>
    </data>
</odoo>

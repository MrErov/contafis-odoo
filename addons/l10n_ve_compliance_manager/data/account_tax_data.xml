<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="tax_group_iva_16" model="account.tax.group">
            <field name="name">IVA 16%</field>
            <field name="country_id" ref="base.ve"/>
        </record>
        <record id="tax_group_iva_8" model="account.tax.group">
            <field name="name">IVA 8%</field>
            <field name="country_id" ref="base.ve"/>
        </record>

        <record id="tax_ve_general_16_purchase" model="account.tax">
            <field name="tax_group_id" ref="tax_group_iva_16"/>
            <field name="name">IVA General 16% (Compra)</field>
            <field name="amount_type">percent</field>
            <field name="amount">16.0</field>
            <field name="type_tax_use">purchase</field>
            <field name="l10n_ve_tax_type">general</field>
            <field name="company_id" ref="base.main_company"/>

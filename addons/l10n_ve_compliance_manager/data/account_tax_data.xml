        <record id="tax_ve_no_credit_16_purchase" model="account.tax">
            <field name="tax_group_id" ref="tax_group_iva_16"/>
            <field name="name">IVA Sin Crédito 16% (Compra)</field>
            <field name="amount_type">percent</field>
            <field name="amount">16.0</field>
            <field name="type_tax_use">purchase</field>
            <field name="l10n_ve_tax_type">no_credit</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="country_id" ref="base.ve"/>
        </record>

    </data>

<odoo>
    <data noupdate="1">
        <!--
        Feriados bancarios 2026 - Venezuela.
        Feriados nacionales (Ley Orgánica del Trabajo) más los días de
        suspensión bancaria tradicional (Carnaval y Semana Santa). El año se
        computa automáticamente desde la fecha.

        noupdate="1": las ediciones del contador sobre esta lista se
        conservan en futuras actualizaciones del módulo (RF-19). Los años
        futuros se cargan o corrigen desde la interfaz (Configuración >
        Feriados bancarios).

        Uso: el corrimiento a día hábil bancario (RF-20) consulta este
        catálogo; los fines de semana se evitan siempre, aunque el año no
        tenga feriados cargados (degradación segura).
        -->
        <record id="bank_holiday_2026_01_01" model="l10n.ve.bank.holiday">
            <field name="name">Año Nuevo</field>
            <field name="date">2026-01-01</field>
        </record>
        <record id="bank_holiday_2026_02_16" model="l10n.ve.bank.holiday">

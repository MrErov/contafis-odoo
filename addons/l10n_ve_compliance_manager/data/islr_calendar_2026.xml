    <data noupdate="1">
        <!--
        Tablas de ISLR 2026 - Estimadas/Anticipos y Retenciones (Fase 004, spec 004).

        ATENCION: fechas de REFERENCIA sujetas a verificacion con la Gaceta
        Oficial (Providencia SNAT/2025/000091, Gaceta 43.283, u otra providencia
        vigente). No se dispone de la fuente oficial a la fecha de carga.

        Patron de referencia acordado con el contador:
          - Estimadas de ISLR: dias 10-19 segun el ultimo digito del RIF
            (0 -> 10 ... 9 -> 19), en los meses de junio, septiembre y
            diciembre, sin corrimiento (month_offset="0").
          - Retenciones de ISLR: mismo patron de dias, los 12 meses del ano,
            con vencimiento el mes siguiente al periodo (month_offset="1").

        noupdate="1": el contador puede corregir estos dias en la interfaz y
        las futuras actualizaciones del modulo no pisan sus cambios (RF-3).
        -->
        <record id="seniat_calendar_2026_est_islr" model="l10n.ve.seniat.calendar.table">
            <field name="year">2026</field>
            <field name="code">est_islr</field>
            <field name="month_offset">0</field>
            <field name="description">Estimadas de ISLR 2026 (anticipos de junio, septiembre y diciembre): fechas de referencia sujetas a verificación con la Gaceta Oficial.</field>
        </record>
        <record id="seniat_calendar_2026_ret_islr" model="l10n.ve.seniat.calendar.table">

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ve_copy_calendar_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ve.copy.calendar.wizard.form</field>
        <field name="model">l10n.ve.copy.calendar.wizard</field>
        <field name="arch" type="xml">
            <form string="Copiar tabla a otro año">
                <group>
                    <field name="source_year" required="1"
                           help="Año del que se copian las tablas (ej. 2026)."/>
                    <field name="target_year" required="1"
                           help="Año nuevo a crear (ej. 2027). Debe estar vacío."/>
                </group>
                <div class="alert alert-info" role="status">
                    <p>Se duplicarán todas las tablas del año origen (a.1, a.2, …)
                       con sus días de vencimiento por mes y dígito de RIF,
                       apuntando al año destino.</p>
                </div>
                <footer>
                    <button name="action_copy" string="Copiar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ve_copy_calendar_wizard" model="ir.actions.act_window">
        <field name="name">Copiar a otro año</field>
        <field name="res_model">l10n.ve.copy.calendar.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

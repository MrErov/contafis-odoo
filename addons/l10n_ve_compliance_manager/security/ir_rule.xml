        <record id="rule_l10n_ve_compliance_client_accountant" model="ir.rule">
            <field name="name">Cliente: solo mi cartera asignada</field>
            <field name="model_id" ref="model_l10n_ve_compliance_client"/>
            <field name="domain_force">[('accountant_id', '=', user.id)]</field>
            <field name="groups" eval="[(6, 0, [ref('account.group_account_user'), ref('l10n_ve_compliance_accountant')])]"/>
        </record>
        <record id="rule_l10n_ve_compliance_client_admin" model="ir.rule">
            <field name="name">Cliente: el administrador ve todo</field>
            <field name="model_id" ref="model_l10n_ve_compliance_client"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>


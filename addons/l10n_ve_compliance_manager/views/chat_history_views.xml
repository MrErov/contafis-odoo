<odoo>
    <record id="view_l10n_ve_chat_history_list" model="ir.ui.view">
        <field name="name">l10n.ve.chat.history.list</field>
        <field name="model">l10n.ve.chat.history</field>
        <field name="arch" type="xml">
            <list string="Historial de Chat" multi_edit="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="company_id" optional="hide"/>
                <field name="role" widget="badge"/>
                <field name="content" optional="hide"/>
                <field name="warnings" widget="json" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ve_chat_history_form" model="ir.ui.view">
        <field name="name">l10n.ve.chat.history.form</field>
        <field name="model">l10n.ve.chat.history</field>
        <field name="arch" type="xml">
            <form string="Mensaje de Chat" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id" readonly="1"/>
                            <field name="conversation_id" readonly="1"/>
                            <field name="role" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_uid" readonly="1"/>
                        </group>
                    </group>
                    <group string="Contenido">
                        <field name="content" nolabel="1" placeholder="Contenido del mensaje..." readonly="1"/>
                    </group>
                    <group string="Warnings">
                        <field name="warnings" widget="json" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

<record id="view_l10n_ve_chat_history_search" model="ir.ui.view">
        <field name="name">l10n.ve.chat.history.search</field>
        <field name="model">l10n.ve.chat.history</field>
        <field name="arch" type="xml">
            <search string="Historial de Chat">
                <field name="user_id" string="Usuario"/>
                <field name="company_id" string="Compañía"/>
                <field name="role" string="Rol"/>
                <field name="content" string="Contenido"/>
                <field name="conversation_id" string="ID Conversación"/>
                <filter string="Usuario" name="filter_user" context="{'group_by': 'user_id'}"/>
                <filter string="Compañía" name="filter_company" context="{'group_by': 'company_id'}"/>
                <filter string="Rol Usuario" name="filter_role_user" domain="[('role', '=', 'user')]"/>
                <filter string="Rol Asistente" name="filter_role_assistant" domain="[('role', '=', 'assistant')]"/>
                <separator/>
                <filter string="Usuario" name="groupby_user" context="{'group_by': 'user_id'}"/>
                <filter string="Compañía" name="groupby_company" context="{'group_by': 'company_id'}"/>
                <filter string="Rol" name="groupby_role" context="{'group_by': 'role'}"/>
                <filter string="Conversación" name="groupby_conversation" context="{'group_by': 'conversation_id'}"/>
                <filter string="Fecha" name="groupby_date" context="{'group_by': 'create_date'}"/>
            </search>
        </field>
    </record>
</odoo>

<odoo>
    <record id="view_l10n_ve_compliance_client_list" model="ir.ui.view">
        <field name="name">l10n.ve.compliance.client.list</field>
        <field name="model">l10n.ve.compliance.client</field>
        <field name="arch" type="xml">
            <list string="Clientes de Cumplimiento">
                <field name="name"/>
                <field name="rif"/>
                <field name="rif_last_digit"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="accountant_id" optional="hide"/>
                <field name="activity_type"/>
                <field name="municipality" optional="show"/>
                <field name="compliance_status"/>
                <field name="compliance_score"/>
                <field name="last_alert_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ve_compliance_client_form" model="ir.ui.view">
        <field name="name">l10n.ve.compliance.client.form</field>
        <field name="model">l10n.ve.compliance.client</field>
        <field name="arch" type="xml">
            <form string="Cliente de Cumplimiento">
                <header>
                    <button name="%(action_report_l10n_ve_compliance_client)d"
                            type="action"
                            string="Imprimir Reporte"
                            class="btn-primary"
                            icon="fa-print"/>
                    <button name="action_open_cartelera_gaps" type="object"
                            string="Ver Brechas Cartelera"
                            icon="fa-exclamation-triangle"
                            class="btn-secondary"/>
                    <button name="action_generate_obligations" type="object"
                            string="Generar obligaciones"
                            icon="fa-calendar-plus-o"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del cliente"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="company_id"/>
                            <field name="accountant_id"/>
                            <field name="activity_type"/>
                        </group>
                        <group>
                            <field name="rif"/>
                            <field name="rif_last_digit" readonly="1"/>
                            <field name="municipality"/>
                            <field name="compliance_status" readonly="1"/>
                            <field name="compliance_score" readonly="1"/>
                            <field name="last_alert_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Obligaciones" name="obligations">
                            <field name="obligation_ids">
                                <list string="Obligaciones">
                                    <field name="name"/>
                                    <field name="obligation_type_id"/>
                                    <field name="period"/>
                                    <field name="quincena"/>
                                    <field name="due_date"/>
                                    <field name="amount" optional="show"/>
                                    <field name="currency_id" optional="hide"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documentos" name="documents">
                            <field name="document_ids">
                                <list string="Documentos">
                                    <field name="document_type_id"/>
                                    <field name="number"/>
                                    <field name="issue_date"/>
                                    <field name="expiry_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alertas" name="alerts">
                            <field name="alert_ids">
                                <list string="Alertas">
                                    <field name="name"/>
                                    <field name="alert_type"/>
                                    <field name="date"/>
                                    <field name="state"/>
                                    <field name="channel"/>
                                </list>
                            </field>
                        </page>
                        <page string="Configuración Fiscal" name="fiscal_config">
                            <group>
                                <group>
                                    <field name="is_spe"/>
                                </group>
                            </group>
                            <field name="applicable_type_ids">
                                <list string="Obligaciones Aplicables">
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="periodicity"/>
                                    <field name="seniat_table_code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ve_compliance_client_search" model="ir.ui.view">
        <field name="name">l10n.ve.compliance.client.search</field>
        <field name="model">l10n.ve.compliance.client</field>
        <field name="arch" type="xml">
            <search string="Clientes de Cumplimiento">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="rif"/>
                <field name="accountant_id"/>
                <field name="activity_type"/>
                <field name="municipality"/>
                <filter name="filter_is_spe" string="SPE" domain="[('is_spe', '=', True)]"/>
            </search>
        </field>
    </record>

<record id="view_l10n_ve_compliance_client_kanban" model="ir.ui.view">
        <field name="name">l10n.ve.compliance.client.kanban</field>
        <field name="model">l10n.ve.compliance.client</field>
        <field name="arch" type="xml">
            <kanban default_group_by="activity_type" class="o_kanban_mobile">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="rif"/>
                <field name="compliance_score"/>
                <field name="compliance_status"/>
                <field name="pending_alert_count"/>
                <field name="cartelera_valid_count"/>
                <field name="cartelera_total_count"/>
                <field name="cartelera_pending_count"/>
                <field name="cartelera_progress"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click h-100 p-2"
                             t-attf-style="border-left: 4px solid #{record.compliance_status.raw_value == 'vencido' ? '#dc3545' : (record.compliance_status.raw_value == 'pendiente' ? '#ffc107' : '#198754')}; background-color: #{record.compliance_status.raw_value == 'vencido' ? '#fff5f5' : (record.compliance_status.raw_value == 'pendiente' ? '#fffaf0' : '#f6fff9')};">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_heading d-flex align-items-center">
                                    <img t-att-src="record.partner_id.raw_value ? '/web/image/res.partner/' + record.partner_id.raw_value + '/image_128' : '/web/static/img/placeholder.png'"
                                         class="o_kanban_image rounded-circle me-2"
                                         style="width: 40px; height: 40px; object-fit: cover;"
                                         alt="Logo"/>
                                    <div>
                                        <strong><field name="partner_id"/></strong>
                                        <div class="text-muted"><field name="name"/></div>
                                    </div>
                                </div>
                                <field name="compliance_status"
                                       widget="badge"
                                       decoration-success="compliance_status == 'al_dia'"
                                       decoration-warning="compliance_status == 'pendiente'"
                                       decoration-danger="compliance_status == 'vencido'"/>
                            </div>
                            <div class="mt-2" t-if="record.cartelera_total_count.raw_value">
                                <div class="d-flex justify-content-between align-items-center small">
                                    <span class="text-muted">Cartelera documental</span>
                                    <span class="fw-semibold">
                                        <field name="cartelera_valid_count"/> / <field name="cartelera_total_count"/>
                                    </span>
                                </div>
                                <div class="progress mt-1" style="height: 6px;">
                                    <div t-attf-class="progress-bar #{record.cartelera_progress.raw_value >= 100 ? 'bg-success' : (record.cartelera_progress.raw_value >= 50 ? 'bg-warning' : 'bg-danger')}"
                                         t-attf-style="width: #{record.cartelera_progress.raw_value}%;"/>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span t-attf-class="badge #{record.cartelera_pending_count.raw_value > 0 ? 'text-bg-danger' : 'text-bg-success'}">
                                        <field name="cartelera_pending_count"/> documentos pendientes
                                    </span>
                                    <span class="badge text-bg-warning" t-if="record.pending_alert_count.raw_value">
                                        <i class="fa fa-bell me-1" title="Alertas pendientes"/><field name="pending_alert_count"/> alertas
                                    </span>
                                </div>
                            </div>
                            <div class="text-muted small mt-2" t-else="">
                                Sin cartelera del mes
                            </div>
                            <div class="oe_kanban_bottom_left o_kanban_redline mt-2">
                                <span class="text-muted small"><field name="rif"/></span>
                                <span class="text-muted small ms-2">
                                    Cumplimiento <field name="compliance_score"/>%
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_l10n_ve_compliance_client" model="ir.actions.act_window">
        <field name="name">Clientes de Cumplimiento</field>
        <field name="res_model">l10n.ve.compliance.client</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree su primer cliente de cumplimiento
            </p>
            <p>
                Registre las empresas gestionadas por el contador y
                vincule sus obligaciones fiscales, parafiscales y documentales.
            </p>
        </field>
    </record>
</odoo>

<odoo>
    <record id="view_l10n_ve_bank_holiday_list" model="ir.ui.view">
        <field name="name">l10n.ve.bank.holiday.list</field>
        <field name="model">l10n.ve.bank.holiday</field>
        <field name="arch" type="xml">
            <list string="Feriados bancarios" editable="bottom">
                <field name="date"/>
                <field name="name"/>
                <field name="year"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ve_bank_holiday_form" model="ir.ui.view">
        <field name="name">l10n.ve.bank.holiday.form</field>
        <field name="model">l10n.ve.bank.holiday</field>
        <field name="arch" type="xml">
            <form string="Feriado bancario">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="name" placeholder="Ej. Lunes de Carnaval"/>
                        <field name="year"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ve_bank_holiday_search" model="ir.ui.view">
        <field name="name">l10n.ve.bank.holiday.search</field>
        <field name="model">l10n.ve.bank.holiday</field>
        <field name="arch" type="xml">
            <search string="Feriados bancarios">
                <field name="name"/>
                <field name="date"/>
                <field name="year"/>
                <group>
                    <filter name="group_year" string="Año" context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ve_bank_holiday" model="ir.actions.act_window">
        <field name="name">Feriados bancarios</field>
        <field name="res_model">l10n.ve.bank.holiday</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

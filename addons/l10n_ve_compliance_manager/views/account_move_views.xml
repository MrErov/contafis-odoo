<odoo>
    <record id="view_account_move_form_l10n_ve_retention" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ve.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_generate_retention"
                        type="object"
                        string="Generar Retención"
                        class="btn-secondary"
                        invisible="move_type != 'in_invoice'"/>
                <button name="action_regenerate_vat_book_line"
                        type="object"
                        string="Regenerar Libro"
                        class="btn-secondary"
                        invisible="state != 'posted' or move_type not in ['in_invoice','out_invoice']"/>
            </xpath>
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Retenciones" name="retentions">
                    <field name="retention_ids">
                        <list string="Retenciones">
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                    <group string="Resumen">
                        <field name="retention_amount" readonly="1"/>
                    </group>
                </page>
                <page string="Info Fiscal VE" name="info_fiscal_ve">
                    <group string="Tipo de Emisión">
                        <field name="emission_type"/>
                        <field name="fiscal_machine_serial"
                               invisible="emission_type != 'maquina_fiscal'"/>
                        <field name="fiscal_machine_report_z"
                               invisible="emission_type != 'maquina_fiscal'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

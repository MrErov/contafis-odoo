<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_ve_chat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="ContaFis AI" name="contafis_ai" logo="fa-comments">
                    <block title="Asistente de IA (Bot)">
                        <setting string="Webhook URL" help="URL del endpoint que recibirá los mensajes (POST JSON).">
                            <field name="l10n_ve_chat_webhook_url" placeholder="https://tu-n8n.com/webhook/contafis"/>
                        </setting>
                        <setting string="API key del asistente"
                                 help="Secreto compartido que Odoo envía en el header X-API-Key (chat y digitalización).">
                            <field name="l10n_ve_chat_auth_token" password="True"/>
                        </setting>
                    </block>
                    <block title="Digitalización de facturas">
                        <setting string="URL del servicio"
                                 help="URL del endpoint /digitize del servicio contafis-assistant.">
                            <field name="l10n_ve_digitize_url" placeholder="https://tu-servicio/digitize"/>
                        </setting>
                        <setting string="Timeout (segundos)"
                                 help="Tiempo máximo de espera de la respuesta del servicio.">
                            <field name="l10n_ve_digitize_timeout_seconds"/>
                        </setting>
                        <setting string="Tamaño máximo de imagen (MB)"
                                 help="Límite local antes de enviar la imagen al servicio.">
                            <field name="l10n_ve_digitize_max_image_mb"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>

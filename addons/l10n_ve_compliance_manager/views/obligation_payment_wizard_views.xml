<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ve_obligation_payment_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ve.obligation.payment.wizard.form</field>
        <field name="model">l10n.ve.obligation.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar pago">
                <group>
                    <field name="obligation_id" readonly="1"/>
                    <field name="payment_date"/>
                    <field name="payment_reference"/>
                    <field name="payment_attachment" widget="binary"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Registrar pago" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

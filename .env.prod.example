# .env.prod.example — variables del stack de producción (docker-compose.prod.yml)
#
# Copiar a `.env.prod` (gitignored) y completar con valores reales.
# NUNCA commitear `.env.prod`.
#
# Nota: Odoo lee su contraseña de `config/odoo.conf/odoo.conf` (también
# gitignored). Mantener POSTGRES_PASSWORD sincronizado con `db_password` allí.

# === PostgreSQL ===
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambiar_por_password_fuerte

# === Odoo ===
ODOO_DB=contea
ODOO_WORKERS=4
# En config/odoo.conf/odoo.conf definir además:
#   admin_passwd = <master password>
#   db_password  = <mismo valor que POSTGRES_PASSWORD>
#   list_db      = False   # recomendado en producción

# === Assistant: conexión a Odoo JSON/2 ===
# API key read-only creada en Odoo (Ajustes > Usuarios > API Keys).
ODOO_API_KEY=cambiar_por_api_key_readonly
ODOO_PROTOCOL=json2
ODOO_TIMEOUT_SECONDS=15
ODOO_READONLY_ATTESTED=true

# === Assistant: LLM y embeddings (NVIDIA NIM, OpenAI-compatible) ===
OPENAI_API_KEY=cambiar_por_api_key_nvidia
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSIONS=2048
LLM_TIMEOUT_SECONDS=60
DIGITIZE_TIMEOUT_SECONDS=120
DIGITIZE_MAX_IMAGE_MB=5

# === Assistant: API ===
APP_ENV=production
API_SHARED_SECRET=cambiar_por_secreto_compartido_largo
# El compose fuerza API_HOST=0.0.0.0 y PORT=8000.

# === Assistant: corpus / retrieval ===
CHROMA_COLLECTION=contafis_normativa_v1
# CHROMA_PATH lo define el compose (/data/chroma, volumen assistant_chroma_data).
VECTOR_BACKEND=chroma
BM25_INDEX_PATH=data/bm25_index.json
BM25_INDEX_VERSION=1
RETRIEVAL_DENSE_TOP_K=10
RETRIEVAL_BM25_TOP_K=10
RETRIEVAL_FINAL_TOP_K=5
RRF_K=60
DENSE_MIN_SCORE=0.30
BM25_MIN_SCORE=1.0
RETRIEVAL_TIMEOUT_SECONDS=10
FUZZY_MIN_SCORE=85

# === Observabilidad (LangSmith) ===
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=cambiar_por_langsmith_api_key
LANGSMITH_PROJECT=contafis-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_CONTENT=true

# === Límites del agente ===
MAX_MESSAGE_CHARS=2000
MAX_TOOL_CALLS=3
RECURSION_LIMIT=12
DETAIL_LIMIT=50
MEMORY_MAX_TURNS=20
MEMORY_MAX_THREADS=500
SCOPE_CHECK_TTL_SECONDS=300
SESSION_MAX_AGE_HOURS=24
